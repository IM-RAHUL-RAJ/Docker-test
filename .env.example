# Copy this file to .env and fill in your RDS details:  cp .env.example .env
# NEVER commit the real .env file (it contains your password).

# postgresql  or  mysql
DB_ENGINE=postgresql

# RDS endpoint: AWS Console -> RDS -> Databases -> your DB -> "Connectivity & security"
DB_HOST=mydb.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=postgres
DB_PASSWORD=change-me

# Alternative: one full URL instead of the five values above
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
